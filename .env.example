# Supabase project URL (e.g. https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key (safe on the client side, respects RLS rules)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "service_role" key (admin, bypasses RLS) — NEVER exposed to the client,
# only used server-side (Server Actions, Route Handlers, scripts).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe secret key (Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Gmail / Google Cloud
GOOGLE_PUBSUB_PROJECT_ID=hakoflow
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Slack
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...
SLACK_SIGNING_SECRET=...   # to verify webhooks

# Discord
DISCORD_CLIENT_ID=...
DISCORD_CLIENT_SECRET=...
DISCORD_PUBLIC_KEY=...     # to verify webhooks
DISCORD_BOT_TOKEN=...      # for the Gateway WebSocket

# OpenAI

OPENAI_API_KEY=
