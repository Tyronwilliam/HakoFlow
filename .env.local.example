# Copier ce fichier en .env.local (gitignored) et remplir avec les valeurs
# du projet Supabase : Project Settings > API.

# URL du projet Supabase (ex: https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique "anon" (safe côté client, respecte les règles RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé "service_role" (admin, bypass RLS) — JAMAIS exposée au client,
# uniquement utilisée côté serveur (Server Actions, Route Handlers, scripts).
SUPABASE_SERVICE_ROLE_KEY=

# Clé secrète Stripe (Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=

# Secret de signature du webhook Stripe (Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=

# Clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
